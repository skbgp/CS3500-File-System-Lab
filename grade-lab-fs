#!/usr/bin/env python3

#
# CS3500 File System Lab -- public grading script
# Run: python3 grade-lab-fs   (or: make grade)
#

import subprocess, sys, re, time, os, signal

TOTAL = 0
POSSIBLE = 0
TIMEOUT = 300

class colors:
    GREEN = '\033[92m'
    RED = '\033[91m'
    YELLOW = '\033[93m'
    BOLD = '\033[1m'
    END = '\033[0m'

def run_qemu_test(command, patterns, timeout=TIMEOUT):
    try:
        subprocess.run(["make", "fs.img"], capture_output=True, timeout=120)
    except Exception:
        pass

    proc = subprocess.Popen(["make", "qemu"], stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    os.set_blocking(proc.stdout.fileno(), False)
    time.sleep(3)

    proc.stdin.write(command.encode('utf-8') + b"\n")
    proc.stdin.flush()

    output = bytearray()
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(0.5)
        try:
            buf = os.read(proc.stdout.fileno(), 8192)
            if buf:
                output.extend(buf)
                text = output.decode("utf-8", "replace")
                if all(re.search(p, text, re.MULTILINE) for p in patterns):
                    break
        except BlockingIOError:
            pass

    proc.terminate()
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()

    text = output.decode("utf-8", "replace")
    return all(re.search(p, text, re.MULTILINE) for p in patterns), text


def test(points, name, command, patterns):
    global TOTAL, POSSIBLE
    POSSIBLE += points
    sys.stdout.write(f"  {name}... ")
    sys.stdout.flush()

    ok, output = run_qemu_test(command, patterns)

    if ok:
        TOTAL += points
        print(f"{colors.GREEN}PASSED ({points}/{points}){colors.END}")
    else:
        print(f"{colors.RED}FAILED (0/{points}){colors.END}")
        for line in output.splitlines()[-10:]:
            if line.strip():
                print(f"    | {line.rstrip()}")
    return ok


def main():
    print(f"\n{colors.BOLD}CS3500 File System Lab - Public Tests{colors.END}")
    print("=" * 50)

    print("\nBuilding...")
    r = subprocess.run(["make", "clean"], capture_output=True)
    r = subprocess.run(["make"], capture_output=True, timeout=120)
    if r.returncode != 0:
        print(f"{colors.RED}BUILD FAILED{colors.END}")
        for line in r.stderr.decode("utf-8", "replace").splitlines()[-15:]:
            print(f"  {line}")
        sys.exit(1)

    r = subprocess.run(["make", "fs.img"], capture_output=True, timeout=120)
    if r.returncode != 0:
        print(f"{colors.RED}fs.img build failed{colors.END}")
        sys.exit(1)

    print(f"{colors.GREEN}Build OK{colors.END}\n")

    print(f"{colors.BOLD}Section 3: inode block tree{colors.END}")
    test(10, "print_itree output",
         "print_itree README",
         [r"^inode \d+ type \d+ size \d+"])

    print(f"\n{colors.BOLD}Section 4: large files{colors.END}")
    test(20, "bigfiletest (270 blocks)",
         "bigfiletest",
         [r"bigfiletest: created 270 blocks"])

    print(f"\n{colors.BOLD}Section 5: symbolic links{colors.END}")
    test(20, "symlinktest",
         "symlinktest",
         [r"symlinktest: passed"])

    print("\n" + "=" * 50)
    print(f"{colors.BOLD}Score: {TOTAL}/{POSSIBLE}{colors.END}")
    if TOTAL == POSSIBLE:
        print(f"{colors.GREEN}All public tests passed!{colors.END}")
    else:
        print(f"{colors.YELLOW}Some tests failed.{colors.END}")
    print()


if __name__ == "__main__":
    main()
